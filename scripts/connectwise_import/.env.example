# ConnectWise API Configuration
# Copy this file to .env and fill in your values

# ConnectWise Credentials
CW_COMPANY_ID=your_company_id
CW_PUBLIC_KEY=your_public_key
CW_PRIVATE_KEY=your_private_key
CW_CLIENT_ID=your_client_id

# ConnectWise API URL (adjust for your region)
# North America: https://api-na.myconnectwise.net
# Europe: https://api-eu.myconnectwise.net
# Australia: https://api-au.myconnectwise.net
CW_API_URL=https://api-na.myconnectwise.net

# Import settings
CW_DAYS_BACK=365  # How many days of history to import

# Retrieval Plugin Configuration
RETRIEVAL_API_URL=http://localhost:8000
BEARER_TOKEN=your_bearer_token
OPENAI_API_KEY=your_openai_api_key

# Datastore Configuration
DATASTORE=pinecone  # or weaviate, qdrant, postgres, etc.

# Add your datastore-specific environment variables below
# Examples:

# Pinecone
# PINECONE_API_KEY=your_pinecone_key
# PINECONE_ENVIRONMENT=your_env
# PINECONE_INDEX=your_index

# Postgres
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=your_password
# PG_DATABASE=retrieval_db
